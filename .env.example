# Vorlage für die lokale Entwicklung: nach .env kopieren (cp .env.example .env).
# Die Werte gelten nur für die Container auf dem eigenen Rechner. Die Zugangsdaten für AWS
# (RDS-Passwort, Learner-Lab-Session) stehen hier bewusst NICHT - sie liegen in AWS Secrets Manager
# bzw. in den GitHub Secrets.

# --- Datenbank (MariaDB-Container) ---
DB_NAME=db_biztrips
DB_USERNAME=biztrips
DB_PASSWORD=local-dev-only
DB_PORT=3306

# --- Bild-Storage (MinIO, S3-kompatibel) ---
S3_BUCKET=biztrips-employee-photos-local
S3_ACCESS_KEY=local-dev
S3_SECRET_KEY=local-dev-only
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Ports auf dem eigenen Rechner ---
# Das Backend erlaubt Browser-Aufrufe (CORS) nur von http://localhost:3000, :3001 und :5173.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# --- Quelle der Images ---
# Standard: beide Images werden aus den nebeneinander ausgecheckten Repos gebaut.
BACKEND_CONTEXT=../RefCard-03-be-SpringBootBusinessTrips
FRONTEND_CONTEXT=../refcard-03-fe-react-vite

# Alternative: fertiges Backend-Image aus ECR verwenden (siehe README, "Images aus ECR").
# BACKEND_IMAGE=<account-id>.dkr.ecr.us-east-1.amazonaws.com/biztrips-backend:1.0.0
